# /etc/wacrm/migrate.env  (owner root:root, mode 0600)
#
# Used only by migrate.sh. Kept apart from wacrm.env so the running app
# never holds the database password.
#
# Supabase dashboard -> Connect -> "Session pooler" connection string.
# Use the SESSION POOLER, not "Direct connection": the direct host is
# IPv6-only and most VMs reach it over IPv4 only. Percent-encode any
# special characters in the password (@ -> %40, # -> %23, $ -> %24, ...).
SUPABASE_DB_URL=postgresql://postgres.your-project-ref:your-password@aws-0-ap-south-1.pooler.supabase.com:5432/postgres
