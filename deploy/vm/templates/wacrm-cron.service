[Unit]
Description=wacrm cron: drain pending automation waits and flow runs
After=wacrm.service
Requires=wacrm.service

[Service]
Type=oneshot
User=@USER@
Group=@USER@
# The header file keeps the secret out of the process list.
ExecStart=/usr/bin/curl -fsS -o /dev/null -m 55 -H @@ETC@/cron-header http://127.0.0.1:@PORT@/api/automations/cron
ExecStart=/usr/bin/curl -fsS -o /dev/null -m 55 -H @@ETC@/cron-header http://127.0.0.1:@PORT@/api/flows/cron
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
CapabilityBoundingSet=
