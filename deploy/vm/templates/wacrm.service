[Unit]
Description=wacrm WhatsApp CRM (Next.js standalone server)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=@USER@
Group=@USER@
WorkingDirectory=@HOME@/current
EnvironmentFile=@ENV@
Environment=NODE_ENV=production NEXT_TELEMETRY_DISABLED=1 HOSTNAME=127.0.0.1 PORT=@PORT@
ExecStart=@NODE@/bin/node server.js
Restart=on-failure
RestartSec=5

# Share the box with the services already on it.
MemoryMax=1G
CPUWeight=50
TasksMax=256

# Containment: no privilege gain, read-only OS, no access to /home or /root
# (so nothing in another account's home is reachable even after an app
# compromise), writes only under the release tree.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=@HOME@/releases
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictSUIDSGID=yes
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallArchitectures=native
CapabilityBoundingSet=
AmbientCapabilities=
UMask=0077

[Install]
WantedBy=multi-user.target
