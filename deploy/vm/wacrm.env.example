# /etc/wacrm/wacrm.env  (owner root:wacrm, mode 0640)
#
# Runtime + build configuration for the wacrm VM deploy. install.sh copies
# this file into place on the first run, generates the two random secrets
# below, and stops so you can fill in the rest.
#
# Plain KEY=value lines only. No `export`, no ${VAR} expansion (systemd
# reads this file directly). Values are taken literally.
#
# NEXT_PUBLIC_* values are inlined into the browser bundle at BUILD time:
# after changing one, rerun install.sh (it rebuilds). Everything else is
# read at runtime: `sudo systemctl restart wacrm` is enough.

# ---- Hosting -----------------------------------------------------------
# Public hostname for the CRM. Create a DNS A record pointing at this VM
# before running install.sh with TLS.
WACRM_DOMAIN=crm.CHANGE_ME.com
# Email certbot registers the Let's Encrypt certificate under.
WACRM_CERTBOT_EMAIL=CHANGE_ME@example.com
# Loopback port for the Node server; nginx proxies to it. Must be free.
WACRM_PORT=3200

# Must equal https://<WACRM_DOMAIN>.
NEXT_PUBLIC_SITE_URL=https://crm.CHANGE_ME.com
# Only these hostnames may appear in team-invite links.
ALLOWED_INVITE_HOSTS=crm.CHANGE_ME.com
# UI language: en | ko | pt | es
NEXT_PUBLIC_APP_LOCALE=en

# ---- Supabase (a NEW project, separate from MoneyMistri's) -------------
# Project Settings -> API. The anon key may be the legacy "anon" JWT or the
# newer "publishable" key; the service role key may be the legacy
# "service_role" JWT or the newer "secret" key.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---- Generated by install.sh -------------------------------------------
# AES-256-GCM key for WhatsApp tokens and AI keys at rest. Changing it
# orphans every stored token. Back it up somewhere safe.
ENCRYPTION_KEY=
# Shared secret the systemd timer sends to the automation/flow cron routes.
AUTOMATION_CRON_SECRET=

# ---- Meta (fill in once your Meta app exists; runtime only) ------------
# Meta for Developers -> your app -> App Settings -> Basic.
# Until META_APP_SECRET is set the webhook rejects every request (fail
# closed); the rest of the app works.
META_APP_SECRET=
# Needed only for message templates with an IMAGE header.
META_APP_ID=
